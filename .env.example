# Copy this file to .env and fill in what you have. .env is gitignored.
# Nothing here is needed to run the site locally: without a database it uses
# users.json, and without an AI key it uses its own written hints.

# --- database (optional locally, required on Vercel) ---
# Supabase: Project Settings -> API. The SECRET key, not the publishable one.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Upstash Redis instead of Supabase, if you prefer:
# KV_REST_API_URL=https://your-db.upstash.io
# KV_REST_API_TOKEN=...

# --- the AI dost (optional) ---
# OpenAI key starts sk-proj-, Anthropic key starts sk-ant-. Either works.
OPENAI_API_KEY=
