# Copy this file to .env and fill in your own values. .env is gitignored, this
# file is NOT: never put a real key in here.
#
# Nothing below is required to run locally: with no database it uses users.json,
# and with no AI key it uses its own written hints.

# --- database (optional locally, required on Vercel) ---
# The URL already ships in vercel.json, so usually only the key is needed.
# Supabase -> Project Settings -> API Keys -> Secret keys. NOT the publishable one.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis instead of Supabase, if you prefer:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- the AI dost (optional) ---
# OpenAI keys start sk-proj-, Anthropic keys start sk-ant-. Either works.
OPENAI_API_KEY=
